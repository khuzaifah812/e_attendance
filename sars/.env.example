DB_PORT=3306
# or one single URL (Clever Cloud / Render):  DATABASE_URL=mysql://user:password@host:3306/dbname
MYSQL_ADDON_HOST=bh1q40v72x8hlt5qepj8-mysql.services.clever-cloud.com
MYSQL_ADDON_DB=bh1q40v72x8hlt5qepj8
MYSQL_ADDON_USER=ufkil4usx322cygc
MYSQL_ADDON_PORT=3306
MYSQL_ADDON_PASSWORD=gFzfBIzPW3WghWywKDcq
MYSQL_ADDON_URI=mysql://ufkil4usx322cygc:gFzfBIzPW3WghWywKDcq@bh1q40v72x8hlt5qepj8-mysql.services.clever-cloud.com:3306/bh1q40v72x8hlt5qepj8    
# ---- Email (leave EMAIL_HOST_USER empty to print emails in the terminal) ----
